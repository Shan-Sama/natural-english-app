{
  "manifest_version": 3,
  "name": "Natural English \u2013 AI Translator",
  "version": "0.2.0",
  "description": "D\u1ecbch AI \u0111a v\u0103n phong v\u00e0 h\u1ecdc ti\u1ebfng Anh, d\u00f9ng API c\u00e1 nh\u00e2n.",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon192.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "128": "icon192.png"
  },
  "commands": {
    "open-translator": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "M\u1edf Natural English Side Panel"
    }
  },
  "optional_host_permissions": [
    "https://*.workers.dev/*"
  ]
}
