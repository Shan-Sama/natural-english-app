{
  "manifest_version": 3,
  "name": "Natural English – AI Translator",
  "version": "0.3.0",
  "description": "Dịch AI đa văn phong và học tiếng Anh, dùng API cá nhân.",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon192.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "icon192.png"
  },
  "commands": {
    "open-translator": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Mở Natural English Side Panel"
    }
  },
  "optional_host_permissions": [
    "https://*.workers.dev/*"
  ]
}
