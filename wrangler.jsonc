{
  "name": "natural-english-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {"directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "ratelimits": [{"name": "TRANSLATE_LIMIT", "namespace_id": "2601124", "simple": {"limit": 20, "period": 60}}],
  "observability": {"enabled": false}
}
